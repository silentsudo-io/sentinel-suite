# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Editor cruft
*.swp
*~
.vs/

# NinjaTrader build artifacts (we ship source only — never compiled output)
*.dll
*.pdb
obj/
bin/

# Built release artifacts
dist/

# check_parity --since-last snapshot: per-machine state, not shared history
.parity-state.json

# Python bytecode from tools/
__pycache__/
*.pyc

# ── Operator-specific config — BELT AND BRACES, NOT THE CONTROL ────────────────────
# The real control is the allowlist: nothing enters src/ that a human did not put there,
# and tools/pre-commit gates staged content against Lab\docs\secretscan.py. These lines
# exist only so a local `*.conf` from the .example templates cannot be added by reflex.
# ⛔ Do NOT start trusting this list. gitignore cannot see a secret INSIDE a file you
# meant to publish, which is this project's actual exposure shape.
private.conf
fleet.conf
*.secret
.secrets/
